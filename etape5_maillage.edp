// ============================================================================
// Convention : -lambda du/dn = g. La formulation faible contient +int1d(g*v).
// ETAPE 5 - Condition de Neumann non homogene
// F2 reste en Dirichlet (label 2), F1 devient Neumann non homogene (label 3).
// -lambda du/dn = g, avec g >= 0.
// ============================================================================

real Lx=6.0, Ly=5.0;

// Bord exterieur
border b1(t=0,1) { x=6*t;       y=0;         label=1; }
border b2(t=0,1) { x=6;         y=1*t;       label=1; }
border b3(t=0,1) { x=6;         y=1+1.5*t;   label=2; } // F2 Dirichlet
border b4(t=0,1) { x=6;         y=2.5+2.5*t; label=1; }
border b5(t=0,1) { x=6-6*t;     y=5;         label=1; }
border b6(t=0,1) { x=0;         y=5-1.5*t;   label=1; }
border b7(t=0,1) { x=0;         y=3.5-1.5*t; label=3; } // F1 Neumann
border b8(t=0,1) { x=0;         y=2-2*t;     label=1; }

// Radiateur R1
border r1a(t=0,1) { x=0.3+1.0*t; y=2.2;       label=10; }
border r1b(t=0,1) { x=1.3;       y=2.2+1.0*t; label=10; }
border r1c(t=0,1) { x=1.3-1.0*t; y=3.2;       label=10; }
border r1d(t=0,1) { x=0.3;       y=3.2-1.0*t; label=10; }

// Radiateur R2
border r2a(t=0,1) { x=4.7+1.0*t; y=1.2;       label=20; }
border r2b(t=0,1) { x=5.7;       y=1.2+1.0*t; label=20; }
border r2c(t=0,1) { x=5.7-1.0*t; y=2.2;       label=20; }
border r2d(t=0,1) { x=4.7;       y=2.2-1.0*t; label=20; }

int n=8;
mesh Th=buildmesh(
    b1(6*n)+b2(1*n)+b3(1.5*n)+b4(2.5*n)
  + b5(6*n)+b6(1.5*n)+b7(1.5*n)+b8(2*n)
  + r1a(6)+r1b(6)+r1c(6)+r1d(6)
  + r2a(6)+r2b(6)+r2c(6)+r2d(6)
);

plot(Th,wait=true,cmm="Maillage - Etape 5");

int regAir=Th(0.1,0.1).region;
int regR1=Th(0.8,2.7).region;
int regR2=Th(5.2,1.7).region;

real lambda1=0.25;
real lambda2=1.0;
real fRad=50.0;
real uD=15.0;
real g=5.0;

fespace Ph(Th,P0);
Ph lambda=lambda1*(region==regAir)
         +lambda2*(region==regR1 || region==regR2);
Ph fvol=fRad*(region==regR1 || region==regR2);

fespace Vh(Th,P1);
Vh u,v;

solve chauffage(u,v)
    = int2d(Th)(lambda*(dx(u)*dx(v)+dy(u)*dy(v)))
    - int2d(Th)(fvol*v)
    + int1d(Th,3)(g*v)
    + on(2,u=uD);

cout << "Etape 5" << endl;
cout << "lambda air = " << lambda1 << endl;
cout << "lambda radiateur = " << lambda2 << endl;
cout << "f = " << fRad << " W/m^3" << endl;
cout << "uD = " << uD << " degC sur le label 2" << endl;
cout << "g = " << g << " W/m^2 sur le label 3" << endl;
cout << "Temperature min = " << u[].min << " C" << endl;
cout << "Temperature max = " << u[].max << " C" << endl;

plot(u,fill=true,value=true,wait=true,
     cmm="Etape 5 - Temperature avec Neumann non homogene");

savemesh(Th,"habitation_etape5.mesh");
{ ofstream fu("temperature_etape5.txt"); fu << u[] << endl; }
